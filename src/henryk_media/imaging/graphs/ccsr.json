{
  "1": {"class_type": "LoadImage", "inputs": {"image": "{{IMAGE}}"}},
  "2": {"class_type": "DownloadAndLoadCCSRModel", "inputs": {"model": "real-world_ccsr-fp16.safetensors"}},
