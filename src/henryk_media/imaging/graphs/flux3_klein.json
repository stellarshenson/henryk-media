{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{IMAGE}}"}
  },
  "2": {
    "class_type": "ImagePadForOutpaint",
    "inputs": {
      "image": ["1", 0],
      "left": "{{PAD_LEFT}}",
      "top": "{{PAD_TOP}}",
      "right": "{{PAD_RIGHT}}",
      "bottom": "{{PAD_BOTTOM}}",
      "feathering": "{{FEATHER}}"
    }
  },
  "3": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "{{UNET}}", "weight_dtype": "default"}
  },
  "4": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["3", 0],
      "lora_name": "flux-3-image-klein-outpaint.safetensors",
      "strength_model": "{{LORA_STRENGTH}}"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "flux2-ae.safetensors"}
  },
  "6": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_bf16.safetensors",
      "type": "flux3",
      "device": "default"
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{PROMPT}}", "clip": ["6", 0]}
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{NEGATIVE_PROMPT}}", "clip": ["6", 0]}
  },
  "9": {
    "class_type": "ReferenceMultiLatent",
    "inputs": {
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["5", 0],
      "resolution": "keep resolution",
      "images.image0": ["2", 0]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "denoise": "{{DENOISE}}"
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["10", 0], "vae": ["5", 0]}
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {"images": ["11", 0], "filename_prefix": "{{FILENAME_PREFIX}}"}
  }
}
