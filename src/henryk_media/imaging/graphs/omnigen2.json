{
  "1": {"class_type": "LoadImage", "inputs": {"image": "{{IMAGE}}"}},
  "2": {"class_type": "ImagePadForOutpaint", "inputs": {"image": ["1", 0], "left": "{{PAD_LEFT}}", "top": "{{PAD_TOP}}", "right": "{{PAD_RIGHT}}", "bottom": "{{PAD_BOTTOM}}", "feathering": "{{FEATHER}}"}},
  "3": {"class_type": "UNETLoader", "inputs": {"unet_name": "omnigen2_fp16.safetensors", "weight_dtype": "default"}},
  "4": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_fp16.safetensors", "type": "omnigen2", "device": "default"}},
  "5": {"class_type": "VAELoader", "inputs": {"vae_name": "omnigen2_ae.safetensors"}},
  "6": {"class_type": "VAEEncode", "inputs": {"pixels": ["2", 0], "vae": ["5", 0]}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{PROMPT}}", "clip": ["4", 0]}},
  "8": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{NEGATIVE_PROMPT}}", "clip": ["4", 0]}},
  "9": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["7", 0], "latent": ["6", 0]}},
  "10": {"class_type": "ReferenceLatent", "inputs": {"conditioning": ["8", 0], "latent": ["6", 0]}},
  "11": {"class_type": "DualCFGGuider", "inputs": {"model": ["3", 0], "cond1": ["9", 0], "cond2": ["10", 0], "negative": ["8", 0], "cfg_conds": "{{CFG}}", "cfg_cond2_negative": 2.0, "style": "regular"}},
  "12": {"class_type": "RandomNoise", "inputs": {"noise_seed": "{{SEED}}"}},
  "13": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "{{SAMPLER}}"}},
  "14": {"class_type": "BasicScheduler", "inputs": {"model": ["3", 0], "scheduler": "{{SCHEDULER}}", "steps": "{{STEPS}}", "denoise": 1.0}},
  "15": {"class_type": "EmptySD3LatentImage", "inputs": {"width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1}},
  "16": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["12", 0], "guider": ["11", 0], "sampler": ["13", 0], "sigmas": ["14", 0], "latent_image": ["15", 0]}},
  "17": {"class_type": "VAEDecode", "inputs": {"samples": ["16", 0], "vae": ["5", 0]}},
  "18": {"class_type": "SaveImage", "inputs": {"images": ["17", 0], "filename_prefix": "{{FILENAME_PREFIX}}"}}
}
