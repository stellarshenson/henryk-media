{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{IMAGE}}"},
    "_meta": {"title": "Start image (fill {{IMAGE}}: file name inside the server's input directory)"}
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "minimax_h3_fl2va_pruned_bf16.safetensors", "weight_dtype": "default"},
    "_meta": {"title": "MiniMax H3 pruned bf16 transformer"}
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"},
    "_meta": {"title": "Qwen3-VL-32B text encoder"}
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"},
    "_meta": {"title": "Video VAE"}
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"},
    "_meta": {"title": "Audio VAE"}
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "prompt": "{{PROMPT}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{LENGTH}}",
      "first_frame": ["1", 0]
    },
    "_meta": {"title": "Image to video conditioning (fill {{PROMPT}}, {{WIDTH}}, {{HEIGHT}}, {{LENGTH}})"}
  },
  "7": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": "{{SEED}}"},
    "_meta": {"title": "Seed (fill {{SEED}})"}
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "res_multistep"},
    "_meta": {"title": "Sampler"}
  },
  "9": {
    "class_type": "BasicScheduler",
    "inputs": {"model": ["2", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0},
    "_meta": {"title": "Schedule; the model's own settings carry shift 12 video and 3 audio"}
  },
  "10": {
    "class_type": "BasicGuider",
    "inputs": {"model": ["2", 0], "conditioning": ["6", 0]},
    "_meta": {"title": "Guider (the checkpoint is CFG-distilled, so there is no negative prompt)"}
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["7", 0],
      "guider": ["10", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["6", 1]
    },
    "_meta": {"title": "Sampler"}
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["11", 0], "vae": ["4", 0]},
    "_meta": {"title": "Decode video"}
  },
  "13": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["11", 0], "vae": ["5", 0]},
    "_meta": {"title": "Decode audio"}
  },
  "16": {
    "class_type": "ImageCrop",
    "inputs": {"image": ["12", 0], "width": "{{CROP_WIDTH}}", "height": "{{CROP_HEIGHT}}", "x": "{{CROP_X}}", "y": "{{CROP_Y}}"},
    "_meta": {"title": "Centre crop of the 32-step render to the preset size (fill {{CROP_WIDTH}}, {{CROP_HEIGHT}}, {{CROP_X}}, {{CROP_Y}})"}
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["16", 0], "audio": ["13", 0], "fps": 24.0, "bit_depth": 8},
    "_meta": {"title": "Video at the native 24 fps"}
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["14", 0], "filename_prefix": "{{FILENAME_PREFIX}}", "format": "auto", "format.codec": "auto"},
    "_meta": {"title": "Save mp4 to the server's output directory (fill {{FILENAME_PREFIX}})"}
  }
}
